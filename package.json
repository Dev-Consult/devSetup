{
	"name": "mise-desktop",
	"description": "Desktop GUI and environment controller for mise",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test:ui": "vitest run",
		"test:rs": "cd src-tauri && cargo test",
		"test": "pnpm test:ui && pnpm test:rs",
		"clippy": "cd src-tauri && cargo clippy -- -D warnings",
		"verify": "pnpm build && pnpm lint && pnpm test && pnpm clippy",
		"preview": "vite preview",
		"tauri:build": "tauri build",
		"tauri": "tauri"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.4",
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-opener": "^2",
		"clsx": "^2.1.1",
		"lucide-react": "^1.69.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.4",
		"zustand": "^5.0.16"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.5",
		"@tauri-apps/cli": "^2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@vitejs/plugin-react": "^6.0.2",
		"jsdom": "^31.0.0",
		"typescript": "~6.0.3",
		"vite": "^8.0.16",
		"vitest": "^5.1.0"
	}
}
